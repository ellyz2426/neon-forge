<style>
  .root {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24;
    gap: 14;
    background-color: rgba(20, 8, 0, 0.94);
    border-radius: 16;
    border-color: #ff4444;
    border-width: 2;
    width: 380;
    height: 440;
  }
  .title {
    font-size: 30;
    color: #ff4444;
  }
  .stat-row {
    flex-direction: row;
    align-items: center;
    gap: 10;
    width: 280;
    justify-content: space-between;
  }
  .stat-label {
    font-size: 16;
    color: #ffaa33;
  }
  .stat-value {
    font-size: 20;
    color: #ffffff;
  }
  .hi-label {
    font-size: 16;
    color: #ffdd44;
  }
  .hi-value {
    font-size: 20;
    color: #ffdd44;
  }
  .divider {
    width: 240;
    height: 1;
    background-color: rgba(255, 68, 68, 0.3);
  }
  .btn {
    padding-top: 12;
    padding-bottom: 12;
    padding-left: 20;
    padding-right: 20;
    background-color: rgba(255, 136, 0, 0.15);
    border-radius: 8;
    border-color: #ff8800;
    border-width: 1;
    width: 260;
    align-items: center;
    cursor: pointer;
    margin-top: 4;
  }
  .btn-text {
    font-size: 18;
    color: #ffffff;
  }
</style>
<Panel class="root">
  <div class="title" id="go-title">FORGE CLOSED</div>
  <div class="divider"></div>
  <div class="stat-row">
    <div class="stat-label">FINAL SCORE</div>
    <div class="stat-value" id="go-score">0</div>
  </div>
  <div class="stat-row">
    <div class="stat-label">WAVES</div>
    <div class="stat-value" id="go-waves">0</div>
  </div>
  <div class="stat-row">
    <div class="stat-label">ORDERS FILLED</div>
    <div class="stat-value" id="go-orders">0</div>
  </div>
  <div class="stat-row">
    <div class="stat-label">BEST COMBO</div>
    <div class="stat-value" id="go-combo">x1</div>
  </div>
  <div class="stat-row">
    <div class="hi-label">HIGH SCORE</div>
    <div class="hi-value" id="go-highscore">0</div>
  </div>
  <div class="divider"></div>
  <div class="btn" id="btn-restart">
    <div class="btn-text">FORGE AGAIN</div>
  </div>
  <div class="btn" id="btn-menu">
    <div class="btn-text">MAIN MENU</div>
  </div>
</Panel>
