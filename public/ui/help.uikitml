<style>
  .root {
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 20;
    gap: 10;
    background-color: rgba(20, 8, 0, 0.96);
    border-radius: 16;
    border-color: #ff8800;
    border-width: 2;
    width: 400;
    height: 520;
  }
  .title {
    font-size: 26;
    color: #ff8800;
  }
  .divider {
    width: 280;
    height: 1;
    background-color: rgba(255, 136, 0, 0.3);
  }
  .step-row {
    flex-direction: row;
    align-items: center;
    gap: 12;
    width: 340;
    padding: 6;
  }
  .step-num {
    font-size: 22;
    color: #ff8800;
    width: 30;
  }
  .step-info {
    flex-direction: column;
    gap: 2;
  }
  .step-title {
    font-size: 16;
    color: #ffffff;
  }
  .step-desc {
    font-size: 12;
    color: #ffaa33;
  }
  .tip-box {
    flex-direction: column;
    align-items: center;
    gap: 4;
    padding: 10;
    background-color: rgba(255, 136, 0, 0.08);
    border-radius: 8;
    border-color: rgba(255, 136, 0, 0.2);
    border-width: 1;
    width: 340;
  }
  .tip-title {
    font-size: 14;
    color: #44ff88;
  }
  .tip-text {
    font-size: 12;
    color: #cccccc;
  }
  .btn-back {
    padding-top: 10;
    padding-bottom: 10;
    padding-left: 20;
    padding-right: 20;
    background-color: rgba(255, 136, 0, 0.15);
    border-radius: 8;
    border-color: #ff8800;
    border-width: 1;
    width: 220;
    align-items: center;
    cursor: pointer;
    margin-top: 6;
  }
  .btn-text {
    font-size: 16;
    color: #ffffff;
  }
</style>
<Panel class="root">
  <div class="title" id="help-title">HOW TO FORGE</div>
  <div class="divider"></div>
  <div class="step-row">
    <div class="step-num">1</div>
    <div class="step-info">
      <div class="step-title">Pick Ingot</div>
      <div class="step-desc">Click the RACK to grab raw metal</div>
    </div>
  </div>
  <div class="step-row">
    <div class="step-num">2</div>
    <div class="step-info">
      <div class="step-title">Heat Metal</div>
      <div class="step-desc">Place in the FORGE until white-hot</div>
    </div>
  </div>
  <div class="step-row">
    <div class="step-num">3</div>
    <div class="step-info">
      <div class="step-title">Hammer Shape</div>
      <div class="step-desc">Strike the ANVIL to form the weapon</div>
    </div>
  </div>
  <div class="step-row">
    <div class="step-num">4</div>
    <div class="step-info">
      <div class="step-title">Quench</div>
      <div class="step-desc">Cool in the TROUGH to harden steel</div>
    </div>
  </div>
  <div class="step-row">
    <div class="step-num">5</div>
    <div class="step-info">
      <div class="step-title">Deliver</div>
      <div class="step-desc">Hand to the customer at the COUNTER</div>
    </div>
  </div>
  <div class="divider"></div>
  <div class="tip-box">
    <div class="tip-title">TIPS</div>
    <div class="tip-text">Use BELLOWS to heat metal faster</div>
    <div class="tip-text">Rush orders give 1.5x score but less time</div>
    <div class="tip-text">Build streaks for bonus points</div>
  </div>
  <div class="btn-back" id="btn-help-back">
    <div class="btn-text">← BACK</div>
  </div>
</Panel>
