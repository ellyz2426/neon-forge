<style>
  .root {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10;
    gap: 12;
    background-color: rgba(20, 8, 0, 0.88);
    border-radius: 10;
    border-color: #ff8800;
    border-width: 1;
    width: 700;
    height: 70;
  }
  .stat-group {
    flex-direction: column;
    align-items: center;
    gap: 2;
  }
  .stat-label {
    font-size: 10;
    color: #ffaa33;
  }
  .stat-value {
    font-size: 20;
    color: #ffffff;
  }
  .combo-value {
    font-size: 20;
    color: #ff8800;
  }
  .lives-value {
    font-size: 20;
    color: #ff4444;
  }
  .wave-value {
    font-size: 20;
    color: #44ff88;
  }
  .hi-value {
    font-size: 14;
    color: #ffdd44;
  }
  .divider {
    width: 1;
    height: 40;
    background-color: rgba(255, 136, 0, 0.3);
  }
  .pause-btn {
    padding-top: 6;
    padding-bottom: 6;
    padding-left: 10;
    padding-right: 10;
    background-color: rgba(255, 136, 0, 0.2);
    border-radius: 6;
    border-color: #ff8800;
    border-width: 1;
    cursor: pointer;
    align-items: center;
  }
  .pause-text {
    font-size: 14;
    color: #ffaa33;
  }
</style>
<Panel class="root">
  <div class="stat-group">
    <div class="stat-label">SCORE</div>
    <div class="stat-value" id="score">0</div>
    <div class="stat-label">HI</div>
    <div class="hi-value" id="highscore">0</div>
  </div>
  <div class="divider"></div>
  <div class="stat-group">
    <div class="stat-label">COMBO</div>
    <div class="combo-value" id="combo">x1</div>
  </div>
  <div class="divider"></div>
  <div class="stat-group">
    <div class="stat-label">WAVE</div>
    <div class="wave-value" id="wave">1</div>
  </div>
  <div class="divider"></div>
  <div class="stat-group">
    <div class="stat-label">LIVES</div>
    <div class="lives-value" id="lives">---</div>
  </div>
  <div class="divider"></div>
  <div class="pause-btn" id="btn-pause">
    <div class="pause-text">II</div>
  </div>
</Panel>
