<style>
  .root {
    flex-direction: column;
    align-items: center;
    padding: 16;
    gap: 10;
    background-color: rgba(20, 8, 0, 0.92);
    border-radius: 12;
    border-color: #ff8800;
    border-width: 1;
    width: 320;
    height: 320;
  }
  .header {
    font-size: 16;
    color: #ffaa33;
  }
  .order-name {
    font-size: 24;
    color: #ffffff;
  }
  .metal-type {
    font-size: 16;
    color: #ff8800;
  }
  .divider {
    width: 200;
    height: 1;
    background-color: rgba(255, 136, 0, 0.3);
  }
  .step-row {
    flex-direction: row;
    align-items: center;
    gap: 8;
    width: 250;
  }
  .step-icon {
    font-size: 16;
    color: #ffaa33;
    width: 30;
  }
  .step-label {
    font-size: 14;
    color: #cccccc;
  }
  .step-status {
    font-size: 14;
    color: #44ff88;
  }
  .timer-label {
    font-size: 14;
    color: #ff4444;
    margin-top: 4;
  }
</style>
<Panel class="root">
  <div class="header" id="order-header">CURRENT ORDER</div>
  <div class="order-name" id="order-name">Iron Sword</div>
  <div class="metal-type" id="order-metal">Metal: Iron</div>
  <div class="divider"></div>
  <div class="step-row">
    <div class="step-icon">🔥</div>
    <div class="step-label">Heat</div>
    <div class="step-status" id="step-heat">---</div>
  </div>
  <div class="step-row">
    <div class="step-icon">🔨</div>
    <div class="step-label">Hammer</div>
    <div class="step-status" id="step-hammer">---</div>
  </div>
  <div class="step-row">
    <div class="step-icon">💧</div>
    <div class="step-label">Quench</div>
    <div class="step-status" id="step-quench">---</div>
  </div>
  <div class="step-row">
    <div class="step-icon">📦</div>
    <div class="step-label">Deliver</div>
    <div class="step-status" id="step-deliver">---</div>
  </div>
  <div class="timer-label" id="order-timer">TIME: 60s</div>
</Panel>
